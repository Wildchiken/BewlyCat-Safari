{
  "manifest_version": 3,
  "name": "BewlyCat",
  "version": "1.7.6",
  "description": "Just make a few small changes to your Bilibili homepage.",
  "homepage_url": "https://github.com/keleus/BewlyCat",
  "background": {
    "scripts": [
      "./dist/background/index.js"
    ],
    "persistent": false
  },
  "icons": {
    "16": "assets/icon-512.png",
    "48": "assets/icon-512.png",
    "128": "assets/icon-512.png",
    "256": "assets/icon-512.png"
  },
  "permissions": [
    "storage",
    "cookies",
    "declarativeNetRequest",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.hdslb.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.bilibili.com/*",
        "*://search.bilibili.com/*",
        "*://t.bilibili.com/*",
        "*://space.bilibili.com/*",
        "*://message.bilibili.com/*",
        "*://member.bilibili.com/*",
        "*://account.bilibili.com/*",
        "*://www.hdslb.com/*",
        "*://passport.bilibili.com/*",
        "*://music.bilibili.com/*"
      ],
      "exclude_matches": [
        "*://www.bilibili.com/match/game*",
        "*://www.bilibili.com/toy*"
      ],
      "js": [
        "./dist/contentScripts/index.global.js"
      ],
      "css": [
        "./dist/contentScripts/style.css"
      ],
      "run_at": "document_start",
      "match_about_blank": true,
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/contentScripts/style.css",
        "dist/contentScripts/inject.global.js",
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "assets/rules.json"
      }
    ]
  },
  "browser_specific_settings": {
    "safari": {}
  }
}
